{
  "name": "@garage/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env src/main.ts",
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "bootstrap": "tsx --env-file=.env src/bootstrap.ts",
    "reminders": "node dist/worker.js",
    "backup": "node dist/backup.js"
  },
  "dependencies": {
    "@garage/shared": "1.0.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0", "@types/pg": "^8.15.6",
    "pg-mem": "^3.0.5", "tsx": "^4.20.6", "typescript": "^5.9.3"
  }
}
