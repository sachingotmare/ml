-- Generated by GitHub Copilot - Nov-01-2026
-- Idempotent provisioning, run by Deploy-GarageManager.ps1 as the PostgreSQL administrator.
-- Never drops/alters existing data, roles' passwords or database ownership.
-- Inputs: -v db=... -v deploy_role=... -v runtime_role=... -v harden=0|1; passwords arrive via
-- environment variables GM_DEPLOY_PW / GM_RUNTIME_PW (read with \getenv), never command arguments.
\set ON_ERROR_STOP on
\getenv deploy_pw GM_DEPLOY_PW
\getenv runtime_pw GM_RUNTIME_PW

SELECT format('CREATE ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD %L', :'deploy_role', :'deploy_pw')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'deploy_role') \gexec
SELECT format('CREATE ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION PASSWORD %L', :'runtime_role', :'runtime_pw')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'runtime_role') \gexec

SELECT NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'db') AS db_new \gset
SELECT format('CREATE DATABASE %I OWNER %I', :'db', :'deploy_role') WHERE :'db_new' = 't' \gexec

-- Refuse to continue when a pre-existing database is owned by someone else.
SELECT pg_get_userbyid(datdba) <> :'deploy_role' AS wrong_owner FROM pg_database WHERE datname = :'db' \gset
\if :wrong_owner
  \echo 'ERROR: database exists but is not owned by the deploy role; reconcile ownership manually.'
  \quit 3
\endif

SELECT format('GRANT CONNECT ON DATABASE %I TO %I, %I', :'db', :'deploy_role', :'runtime_role') \gexec
\if :db_new
  \set harden 1
\endif
\if :harden
  SELECT format('REVOKE ALL ON DATABASE %I FROM PUBLIC', :'db') \gexec
\endif
\connect :db
\if :harden
  REVOKE ALL ON SCHEMA public FROM PUBLIC;
\endif
SELECT format('GRANT USAGE, CREATE ON SCHEMA public TO %I', :'deploy_role') \gexec
SELECT format('GRANT USAGE ON SCHEMA public TO %I', :'runtime_role') \gexec
